# Default row limit per table (descending ID slice)
ROW_LIMIT=5000

# ====================================================
# Local MySQL Server (hosts: misc63, misc64, fpbx62)
# ====================================================
LOCAL_MYSQL_HOST=127.0.0.1
LOCAL_MYSQL_PORT=3306
LOCAL_MYSQL_USER=root
LOCAL_MYSQL_PASS=""

# ====================================================
# Local MariaDB Server (hosts: misc61, misc62)
# ====================================================
LOCAL_MARIADB_HOST=127.0.0.1
LOCAL_MARIADB_PORT=3307
LOCAL_MARIADB_USER=root
LOCAL_MARIADB_PASS=""

# ====================================================
# Remote Server 1: misc61 (MariaDB)
# ====================================================
MISC61_ENGINE=mariadb
MISC61_HOST=your_misc61_host
MISC61_PORT=3306
MISC61_USER=your_username
MISC61_PASS="your_password"

# ====================================================
# Remote Server 2: misc62 (MariaDB)
# ====================================================
MISC62_ENGINE=mariadb
MISC62_HOST=your_misc62_host
MISC62_PORT=3306
MISC62_USER=your_username
MISC62_PASS="your_password"

# ====================================================
# Remote Server 3: misc63 (MySQL)
# ====================================================
MISC63_ENGINE=mysql
MISC63_HOST=your_misc63_host
MISC63_PORT=3306
MISC63_USER=your_username
MISC63_PASS="your_password"

# ====================================================
# Remote Server 4: misc64 (MySQL)
# ====================================================
MISC64_ENGINE=mysql
MISC64_HOST=your_misc64_host
MISC64_PORT=3306
MISC64_USER=your_username
MISC64_PASS="your_password"

# ====================================================
# Remote Server 5: fpbx62 (MySQL)
# ====================================================
FPBX62_ENGINE=mysql
FPBX62_HOST=your_fpbx62_host
FPBX62_PORT=3306
FPBX62_USER=your_username
FPBX62_PASS="your_password"
