# Default row limit per table (descending ID slice)
ROW_LIMIT=5000

# ====================================================
# Local Server (target for import.sh)
# ====================================================
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3306
LOCAL_DB_USER=root
LOCAL_DB_PASS=""

