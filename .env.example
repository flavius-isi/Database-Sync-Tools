# Remote / Development Server Database Settings (Source for export scripts)
REMOTE_DB_HOST=your_remote_db_host
REMOTE_DB_PORT=3306
REMOTE_DB_USER=username
REMOTE_DB_PASS="password"

# Default row limit per table
ROW_LIMIT=5000

# Local MySQL Database Settings (Target for import_us.sh)
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3306
LOCAL_DB_USER=root
LOCAL_DB_PASS=""
